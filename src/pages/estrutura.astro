---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { url } from '../lib/url';
import CasaBloco from '../components/CasaBloco.astro';
import { casas } from '../data/casas';
---
<BaseLayout title="Estrutura | Paraíso da Criança" description="Conheça os ambientes e as casas do Paraíso da Criança.">
  <PageIntro eyebrow="Estrutura" title="Ambientes que dão vontade de ficar.">
    Cada casa acompanha uma fase da infância. Os espaços são organizados para acolher, provocar encontros e deixar a curiosidade circular.
  </PageIntro>

  <section class="section section-white">
    <div class="container split">
      <div class="photo-stack">
        <figure class="photo-card"><img src={url('/images/music.webp')} alt="Bebê explora as cordas de um violão" loading="lazy" /><span class="photo-label">Descobertas pela música</span></figure>
      </div>
      <div>
        <p class="kicker">Dentro e fora</p>
        <h2>Espaço também educa.</h2>
        <p class="lede">Salas, ateliês e áreas externas formam um território de experiências. Materiais acessíveis e diferentes possibilidades de movimento ajudam a criança a investigar no seu próprio ritmo.</p>
        <p class="lede">A natureza está presente na paisagem e nas propostas, com oportunidades para observar, cuidar, criar e brincar ao ar livre.</p>
      </div>
    </div>
  </section>

  <section class="section section-paper" id="casas">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker">Nossas casas</p>
          <h2>Um nome para cada etapa.</h2>
        </div>
        <p>Conheça a organização das turmas por faixa etária.</p>
      </div>
      <div class="casa-lista">
        {casas.map((casa) => <CasaBloco casa={casa} />)}
      </div>
      <p class="faq-chamada">Dúvidas sobre idades, turnos ou horários? <a class="text-link" href={url('/agende-visita#perguntas-frequentes')}>Ver perguntas frequentes <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="section section-white">
    <div class="container split split-reverse">
      <figure class="photo-card tall"><img src={url('/images/grass-circle.webp')} alt="Crianças brincam juntas na grama" loading="lazy" /><span class="photo-label">Natureza que inspira</span></figure>
      <div>
        <p class="kicker">O lado de fora</p>
        <h2>Quando o jardim vira pergunta.</h2>
        <p class="lede">A experiência ao ar livre convida a perceber texturas, sons, luzes, ciclos e mudanças. O jardim é cenário de brincadeira e também matéria para aprender.</p>
      </div>
    </div>
  </section>
</BaseLayout>
