---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import VisitaForm from '../components/VisitaForm.astro';
import Faq from '../components/Faq.astro';
import MapaFachada from '../components/MapaFachada.astro';
import { site } from '../data/site';
import { whatsapp } from '../lib/whatsapp';
---
<BaseLayout title="Agende sua visita | Paraíso da Criança" description="Entre em contato e agende uma visita ao Paraíso da Criança.">
  <PageIntro eyebrow="Agende sua visita" title="Venha conhecer o nosso jeito de cuidar." compacto>
    Fale com a secretaria pelo WhatsApp ou pelo telefone, ou deixe seus dados no formulário abaixo. A equipe entende o momento da sua família e combina o melhor horário para a visita.
    <Fragment slot="acoes">
      <div class="hero-actions">
        <a class="button button-light" data-cta-principal href={whatsapp()} target="_blank" rel="noreferrer">Conversar no WhatsApp <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href={site.telefoneHref}>Ligar para a escola</a>
      </div>
      <p class="intro-nota">O número {site.telefone} atende por telefone e WhatsApp, {site.atendimento.toLowerCase()}. O botão do WhatsApp abre em nova aba, com uma mensagem pronta para você completar.</p>
    </Fragment>
  </PageIntro>

  <section class="section section-white" id="formulario">
    <div class="container">
      <div class="visit-card">
        <div>
          <p class="kicker">Prefere que a gente retorne?</p>
          <h2>Deixe seu contato.</h2>
          <p>Preencha os dados abaixo e a secretaria entra em contato para combinar a visita e responder suas dúvidas.</p>
          <VisitaForm />
        </div>
        <div class="visit-details">
          <div class="visit-detail"><strong>Telefone e WhatsApp</strong><a href={site.telefoneHref}>{site.telefone}</a></div>
          <div class="visit-detail"><strong>Horário de atendimento</strong><span>{site.atendimento}</span></div>
          {site.prazoResposta && <div class="visit-detail"><strong>Prazo de resposta</strong><span>{site.prazoResposta}</span></div>}
          {site.diasVisita && <div class="visit-detail"><strong>Dias e horários de visita</strong><span>{site.diasVisita}</span></div>}
          <div class="visit-detail"><strong>Endereço</strong><span>{site.endereco}</span><a class="map-link" href={site.mapaHref} target="_blank" rel="noreferrer">Abrir no mapa ↗</a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-paper" id="matricula">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker">Como funciona a matrícula</p>
          <h2>Três passos até a matrícula.</h2>
        </div>
        <p>A secretaria acompanha cada etapa e explica os detalhes da matrícula.</p>
      </div>
      <ol class="pedagogy-grid passos">
        <li class="pedagogy-card"><span class="value-number">01</span><h3>Converse com a secretaria</h3><p>Pelo WhatsApp, pelo telefone ou pelo formulário desta página. Conte a idade da criança e o período de interesse.</p></li>
        <li class="pedagogy-card"><span class="value-number">02</span><h3>Agende e faça a visita</h3><p>Conheça os ambientes, a casa da faixa etária do seu filho e tire suas dúvidas com a equipe.</p></li>
        <li class="pedagogy-card"><span class="value-number">03</span><h3>Confirme a matrícula</h3><p>A secretaria informa os valores, as condições e os próximos passos para a matrícula.</p></li>
      </ol>
    </div>
  </section>

  <section class="section section-white" id="perguntas-frequentes">
    <div class="container split split-top">
      <div>
        <p class="kicker">Perguntas frequentes</p>
        <h2>Antes da visita.</h2>
        <p class="lede">Se alguma dúvida ficar, a secretaria pode explicar tudo com calma pelo WhatsApp ou pelo telefone.</p>
      </div>
      <Faq />
    </div>
  </section>

  <section class="section section-paper" id="como-chegar">
    <div class="container split">
      <div>
        <p class="kicker">Como chegar</p>
        <h2>Onde estamos.</h2>
        <p class="lede">{site.endereco}</p>
        <a class="text-link" href={site.mapaHref} target="_blank" rel="noreferrer">Abrir no mapa <span aria-hidden="true">↗</span></a>
      </div>
      <MapaFachada />
    </div>
  </section>
</BaseLayout>
