---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import VisitaForm from '../components/VisitaForm.astro';
import { site } from '../data/site';
import { whatsapp } from '../lib/whatsapp';
---
<BaseLayout title="Agende sua visita | Paraíso da Criança" description="Entre em contato e agende uma visita ao Paraíso da Criança.">
  <PageIntro eyebrow="Agende sua visita" title="Venha conhecer o nosso jeito de cuidar." compacto>
    Fale com a secretaria pelo WhatsApp ou pelo telefone, ou deixe seus dados no formulário abaixo. A equipe entende o momento da sua família e combina o melhor horário para a visita.
    <Fragment slot="acoes">
      <div class="hero-actions">
        <a class="button button-light" data-cta-principal href={whatsapp()} target="_blank" rel="noreferrer">Conversar no WhatsApp <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href={site.telefoneHref}>Ligar para a escola</a>
      </div>
      <p class="intro-nota">O número {site.telefone} atende por telefone e WhatsApp, {site.atendimento.toLowerCase()}. O botão do WhatsApp abre em nova aba, com uma mensagem pronta para você completar.</p>
    </Fragment>
  </PageIntro>

  <section class="section section-white">
    <div class="container">
      <div class="visit-card">
        <div>
          <p class="kicker">Prefere que a gente retorne?</p>
          <h2>Deixe seu contato.</h2>
          <p>Preencha os dados abaixo e a secretaria entra em contato para combinar a visita e responder suas dúvidas.</p>
          <VisitaForm />
        </div>
        <div class="visit-details">
          <div class="visit-detail"><strong>Telefone e WhatsApp</strong><a href={site.telefoneHref}>{site.telefone}</a></div>
          <div class="visit-detail"><strong>Horário de atendimento</strong><span>{site.atendimento}</span></div>
          {site.prazoResposta && <div class="visit-detail"><strong>Prazo de resposta</strong><span>{site.prazoResposta}</span></div>}
          {site.diasVisita && <div class="visit-detail"><strong>Dias e horários de visita</strong><span>{site.diasVisita}</span></div>}
          <div class="visit-detail"><strong>Endereço</strong><span>{site.endereco}</span><a class="map-link" href={site.mapaHref} target="_blank" rel="noreferrer">Abrir no mapa ↗</a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-paper">
    <div class="container split">
      <div>
        <p class="kicker">Perguntas frequentes</p>
        <h2>Antes da visita.</h2>
        <p class="lede">Se alguma dúvida ficar, a secretaria pode explicar tudo com calma pelo WhatsApp.</p>
      </div>
      <div class="faq">
        <details><summary>Para quais idades a escola atende?</summary><p>O Paraíso recebe crianças de 6 meses a 6 anos, organizadas nas casas Nuvem, Sol, Lua e Lagos e Espaço Estrela.</p></details>
        <details><summary>Como agendo um horário?</summary><p>Envie uma mensagem pelo WhatsApp. A secretaria retorna para encontrar um horário de visita.</p></details>
        <details><summary>Onde a escola fica?</summary><p>Estamos na Rua Des. Ernani G. Cartaxo, 564, no Capão Raso, em Curitiba.</p></details>
      </div>
    </div>
  </section>
</BaseLayout>
