---
import { navegacao } from '../data/site';
import { whatsapp as linkWhatsapp } from '../lib/whatsapp';
import { url } from '../lib/url';

const normalizar = (caminho: string) => caminho.replace(/\/$/, '') || '/';
const atual = normalizar(Astro.url.pathname);
const whatsapp = linkWhatsapp();
const ativo = (href: string) => normalizar(url(href)) === atual;
---
<header class="site-header">
  <div class="nav-shell">
    <a class="brand" href={url('/')} aria-label="Página inicial — Paraíso da Criança"><img src={url('/images/logo-paraiso.svg')} alt="Paraíso da Criança — Educação Infantil" /></a>
    <nav class="desktop-nav" aria-label="Navegação principal">
      {navegacao.map((item) => (
        <a class:list={{ active: ativo(item.href) }} aria-current={ativo(item.href) ? 'page' : undefined} href={url(item.href)}>{item.label}</a>
      ))}
    </nav>
    <a class="nav-cta" href={whatsapp} target="_blank" rel="noreferrer">Conversar no WhatsApp <span aria-hidden="true">↗</span></a>
    <a class="nav-whatsapp" href={whatsapp} target="_blank" rel="noreferrer" aria-label="Conversar no WhatsApp (abre em nova aba)">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.66 15l-1.3 4.76 4.88-1.28A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-2.9.76.78-2.83-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.14c-.25-.12-1.46-.72-1.69-.8-.22-.08-.39-.12-.55.13-.16.24-.64.8-.78.96-.15.17-.29.19-.54.06a6.7 6.7 0 0 1-3.32-2.9c-.25-.43.25-.4.72-1.33.08-.16.04-.3-.02-.42-.06-.13-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47a.9.9 0 0 0-.65.3 2.74 2.74 0 0 0-.86 2.04 4.77 4.77 0 0 0 1 2.53 10.9 10.9 0 0 0 4.18 3.7c1.56.67 2.17.73 2.95.61.47-.07 1.46-.6 1.66-1.17.2-.58.2-1.07.15-1.17-.07-.1-.23-.16-.47-.28Z"/></svg>
    </a>
    <details class="mobile-menu">
      <summary aria-label="Abrir menu">Menu <span aria-hidden="true">☰</span></summary>
      <nav aria-label="Navegação móvel">
        {navegacao.map((item) => (
          <a class:list={{ active: ativo(item.href) }} aria-current={ativo(item.href) ? 'page' : undefined} href={url(item.href)}>{item.label}</a>
        ))}
        <a class="mobile-whatsapp" href={whatsapp} target="_blank" rel="noreferrer">Conversar no WhatsApp</a>
      </nav>
    </details>
  </div>
</header>
