---
interface Props {
  eyebrow: string;
  title: string;
  /** Faixa mais baixa, para trazer a ação principal para a primeira tela. */
  compacto?: boolean;
}

const { eyebrow, title, compacto = false } = Astro.props;
---
<section class:list={['page-intro page-intro-red', { 'page-intro-compacto': compacto }]}>
  <div class="container narrow">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="intro-copy"><slot /></p>
    <slot name="acoes" />
  </div>
</section>
