---
import { faq } from '../data/faq';
import Link from './Link.astro';

const temas = faq
  .map((t) => ({ ...t, perguntas: t.perguntas.filter((p) => p.publicar) }))
  .filter((t) => t.perguntas.length > 0);
---
<div class="faq">
  {temas.map((t) => (
    <div class="faq-tema">
      <h3>{t.tema}</h3>
      {t.perguntas.map((p) => (
        <details>
          <summary>{p.pergunta}</summary>
          <div class="faq-resposta">
            <div set:html={p.resposta} />
            {p.link && <Link class="text-link" href={p.link.href}>{p.link.rotulo}</Link>}
          </div>
        </details>
      ))}
    </div>
  ))}
</div>
